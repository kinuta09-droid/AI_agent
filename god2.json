const fs = require('fs');
const { exec
} = require('child_process');

// --- 設定エリア（あなたの環境のパスを反映済み） ---
const inputPath = 'C:\\obsidian\\Obsidian\\Dev_Logs\\Agent_Input.md';
// const outputPath = 'C:\\obsidian\\Obsidian\\Agent_Output.md'; // Removed
const pythonPath = 'C:\\AI_agent\\antigravity_env\\Scripts\\python.exe';
const scriptPath = 'C:\\AI_agent\\agent_hello.py';
// --------------------------------------------------
// 1. Obsidianから命令を読み込む（ここは一瞬なのでSyncでOK）
let task = '';
try {
  if (fs.existsSync(inputPath)) {
    const content = fs.readFileSync(inputPath, 'utf-8').trim();
    let task = '';
    if (content) task = content;
  }
} catch (e) {
  return [
    { json: { error: `Read Error: ${e.message
        }`
      }
    }
  ];
}

if (!task) {
  return [
    { json: { status: 'No task found'
      }
    }
  ];
}
// 2. Pythonを非同期で実行する関数
// これがn8nをフリーズさせないための重要な仕組みです
function runPythonAsync(cmd) {
  return new Promise((resolve, reject) => {
    // execは非同期です。実行中もn8nの心臓は動き続けます。
    exec(cmd,
    { encoding: 'utf-8', maxBuffer: 1024 * 1024 * 10
    }, (error, stdout, stderr) => {
      if (error) {
        // エラーログ(stderr)があればそれを、なければエラーメッセージを返す
        reject(stderr || error.message);
        return;
      }
      resolve(stdout);
    });
  });
}
// 3. メイン実行処理
try {
  // Windows用にパスと引数を安全にエスケープ
  const safeTask = task.replace(/"/g, '\\"').replace(/\n/g,
  " ");
  const command = `${pythonPath
  } ${scriptPath
  } "${safeTask}"`;

  // 【重要】ここでPythonの完了を待ちますが、n8nは止まりません
  const agentResult = await runPythonAsync(command);

  // 4. 結果をObsidianに書き込む (Python側で行うため削除)
  // const timestamp = new Date().toLocaleString();
  // const contentToWrite = ...;
  // fs.appendFileSync(outputPath, contentToWrite, 'utf-8');
  // 成功ステータスを返す
  return [
    { json: { status: 'Success', task: task, result: agentResult
      }
    }
  ];
} catch (e) {
  // エラー時の処理
  // エラー出力 (Python側で行うため削除)
  // const timestamp = new Date().toLocaleString();
  // ...
  // fs.appendFileSync(outputPath, errorLog, 'utf-8');

  return [
    { json: { error: `Python Execution Failed: ${e
        }`
      }
    }
  ];
}