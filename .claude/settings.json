{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "py \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_edit_encoding.py\""
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "py \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_bash_encoding.py\""
          },
          {
            "type": "command",
            "command": "py \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_git_commit.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cat >/dev/null || true; command -v code-review-graph >/dev/null 2>&1 || exit 0; git rev-parse --git-dir >/dev/null 2>&1 && PYTHONIOENCODING=utf-8 code-review-graph update --skip-flows --repo \"$(git rev-parse --show-toplevel 2>/dev/null)\" || true",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cat >/dev/null || true; command -v code-review-graph >/dev/null 2>&1 || exit 0; if git rev-parse --git-dir >/dev/null 2>&1; then PYTHONIOENCODING=utf-8 code-review-graph status --repo \"$(git rev-parse --show-toplevel)\"; else echo 'Not a git repo, skipping'; fi",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "py \"${CLAUDE_PROJECT_DIR}/.claude/hooks/check_remote_divergence.py\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
